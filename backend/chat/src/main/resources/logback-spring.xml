<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="chat-service"/>
    <springProperty scope="context" name="lokiUrl" source="logging.loki.url" defaultValue="http://localhost:3100/loki/api/v1/push"/>
    
    <!-- Console Appender with colored pattern -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%highlight(%level)|%green(%d{yyyy-MM-dd HH:mm:ss})|%blue(%thread)|%yellow(%logger)|%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Loki Appender -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>${lokiUrl}</url>
        </http>
        <format>
            <label>
                <pattern>app=${appName},host=${HOSTNAME},level=%level,severity=%level</pattern>
            </label>
            <message>
                <pattern>
                    {
                    "level":"%level",
                    "class":"%logger{36}",
                    "thread":"%thread",
                    "message": "%message",
                    "exception": "%ex"
                    }
                </pattern>
            </message>
        </format>
        <batchSize>100</batchSize>
        <batchTimeoutMs>5000</batchTimeoutMs>
    </appender>

    <!-- Async wrapper for Loki to avoid blocking -->
    <appender name="ASYNC_LOKI" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="LOKI"/>
        <queueSize>1000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <includeCallerData>true</includeCallerData>
    </appender>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ASYNC_LOKI"/>
    </root>

    <!-- Service specific loggers -->
    <logger name="chat" level="DEBUG"/>
    <logger name="com.auction" level="DEBUG"/>
    
    <!-- Reduce verbosity of some libraries -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="io.grpc" level="INFO"/>
    <logger name="reactor" level="INFO"/>
</configuration>
